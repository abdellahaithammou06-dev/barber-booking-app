# Serveur HTTP
PORT=3000
NODE_ENV=development
TRUST_PROXY_HOPS=1
DB_POOL_LIMIT=10
DB_QUEUE_LIMIT=100

# Base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=barber_booking
DB_USER=barber_app
DB_PASSWORD=remplacez-moi

# Authentification JWT (à générer avec des valeurs longues, uniques et secrètes)
JWT_ACCESS_SECRET=remplacez-par-un-secret-access-long-et-aleatoire
JWT_REFRESH_SECRET=remplacez-par-un-secret-refresh-long-et-aleatoire
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Connexion Google (identifiant client OAuth pour une application Web)
GOOGLE_CLIENT_ID=

# Envoi des e-mails par Brevo (prioritaire) ou Resend
BREVO_API_KEY=
MAIL_FROM=
RESEND_API_KEY=
CONTACT_EMAIL=abdellahaithammou06@gmail.com
CONTACT_FROM_EMAIL=Barber Booking <onboarding@resend.dev>
PUBLIC_APP_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=false

# Annulation client : délai minimal avant le rendez-vous
APPOINTMENT_CANCELLATION_MIN_HOURS=2

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=appointment_reminder
WHATSAPP_TEMPLATE_LANGUAGE=fr
APPOINTMENT_REMINDER_MINUTES=60
